{
  "openapi": "3.0.3",
  "info": {
    "title": "Ratary API — SDK v1 surface",
    "description": "Curated OpenAPI SSOT for @ratary/sdk generation (Phase 16). Full spec at GET /docs/json.",
    "version": "1.2.3"
  },
  "servers": [{ "url": "http://localhost:9876/api/v1" }],
  "security": [{ "BearerAuth": [] }, { "ApiKeyAuth": [] }],
  "components": {
    "securitySchemes": {
      "BearerAuth": { "type": "http", "scheme": "bearer" },
      "ApiKeyAuth": { "type": "apiKey", "in": "header", "name": "X-API-Key" }
    },
    "schemas": {
      "Memory": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "summary": { "type": "string" },
          "project": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "favorite": { "type": "boolean" },
          "archived": { "type": "boolean" },
          "lifecycleState": {
            "type": "string",
            "enum": ["active", "stale", "candidate_compress"],
            "description": "Optional stewardship lifecycle hint when set"
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateMemoryRequest": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" },
          "summary": { "type": "string" },
          "project": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "UpdateMemoryRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" },
          "summary": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "BuildContextRequest": {
        "type": "object",
        "required": ["task"],
        "properties": {
          "task": { "type": "string" },
          "maxTokens": { "type": "integer" },
          "project": { "type": "string" }
        }
      },
      "BuildContextResponse": {
        "type": "object",
        "properties": {
          "context": { "type": "string" },
          "prompt": { "type": "string" },
          "system": { "type": "string" },
          "user": { "type": "string" },
          "memoryCount": { "type": "integer" },
          "packageId": { "type": "string", "description": "ADR-1011 Ratary-issued Context Package id" },
          "ownerId": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "confidenceModel": {
            "type": "string",
            "enum": ["heuristic-top-relevance-v1", "confidence-product-v1"],
            "description": "ADR-1016 confidence derivation model id"
          },
          "updateMechanism": { "type": "string" },
          "lifecycleState": {
            "type": "string",
            "enum": ["active", "retired", "archived"],
            "description": "ADR-1013 usage eligibility; mint is always active"
          },
          "sourceLabels": { "type": "array", "items": { "type": "string" } },
          "query": { "type": "string" },
          "retrievalMemo": {
            "type": "string",
            "enum": ["hit", "miss", "bypass"],
            "description": "ADR-1018 ranked-candidate memo status; package envelope always reminted"
          }
        }
      },
      "ContextPackageLifecycle": {
        "type": "object",
        "required": ["packageId", "ownerId", "lifecycleState", "createdAt", "updatedAt"],
        "properties": {
          "packageId": { "type": "string" },
          "ownerId": { "type": "string" },
          "lifecycleState": { "type": "string", "enum": ["active", "retired", "archived"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ClientCapabilityRequest": {
        "type": "object",
        "properties": {
          "protocolVersion": { "type": "string" },
          "clientInfo": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" }
            },
            "required": ["name", "version"]
          },
          "requiredCapabilities": { "type": "array", "items": { "type": "string" } },
          "preferredCapabilities": { "type": "array", "items": { "type": "string" } },
          "transports": { "type": "array", "items": { "type": "string" } }
        }
      },
      "CapabilityMatchGroups": {
        "type": "object",
        "properties": {
          "required": { "type": "array", "items": { "type": "string" } },
          "preferred": { "type": "array", "items": { "type": "string" } },
          "transports": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["required", "preferred", "transports"]
      },
      "CapabilityNegotiationResult": {
        "type": "object",
        "properties": {
          "compatible": { "type": "boolean" },
          "negotiatedProtocolVersion": { "type": "string" },
          "serverProtocolVersion": { "type": "string" },
          "supportedProtocolVersions": { "type": "array", "items": { "type": "string" } },
          "matched": { "$ref": "#/components/schemas/CapabilityMatchGroups" },
          "missing": { "$ref": "#/components/schemas/CapabilityMatchGroups" },
          "serverEnabledCapabilities": { "type": "array", "items": { "type": "string" } },
          "capabilitiesUrl": { "type": "string" },
          "negotiateUrl": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": [
          "compatible",
          "negotiatedProtocolVersion",
          "serverProtocolVersion",
          "supportedProtocolVersions",
          "matched",
          "missing",
          "serverEnabledCapabilities",
          "capabilitiesUrl",
          "negotiateUrl",
          "timestamp"
        ]
      },
      "GovernanceExceptionRecord": {
        "type": "object",
        "required": [
          "exceptionId",
          "ownerId",
          "exceptionClass",
          "rationale",
          "status",
          "requestedBy",
          "requestedAt",
          "auditLog"
        ],
        "properties": {
          "exceptionId": { "type": "string" },
          "ownerId": { "type": "string" },
          "exceptionClass": {
            "type": "string",
            "enum": ["decay_protection", "feature_flag_off", "ops_maintenance"]
          },
          "rationale": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected", "expired"]
          },
          "requestedBy": { "type": "string" },
          "requestedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "auditLog": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": { "type": "string", "format": "date-time" },
                "action": { "type": "string" },
                "actor": { "type": "string" },
                "note": { "type": "string" }
              },
              "required": ["at", "action"]
            }
          }
        }
      },
      "CreateGovernanceExceptionRequest": {
        "type": "object",
        "required": ["exceptionClass", "rationale"],
        "properties": {
          "exceptionClass": {
            "type": "string",
            "enum": ["decay_protection", "feature_flag_off", "ops_maintenance"]
          },
          "rationale": { "type": "string", "maxLength": 4000 },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "PolicyDenialEvent": {
        "type": "object",
        "required": ["denialId", "ownerId", "point", "reasonCode", "occurredAt"],
        "properties": {
          "denialId": { "type": "string" },
          "ownerId": { "type": "string" },
          "point": { "type": "string", "enum": ["write", "recall", "stewardship"] },
          "policyModuleId": { "type": "string" },
          "reasonCode": { "type": "string" },
          "occurredAt": { "type": "string", "format": "date-time" },
          "memoryId": { "type": "string" },
          "resource": { "type": "string" }
        }
      },
      "PolicyDenialSummary": {
        "type": "object",
        "required": ["since", "byPoint", "total"],
        "properties": {
          "since": { "type": "string", "format": "date-time" },
          "byPoint": {
            "type": "object",
            "properties": {
              "write": { "type": "integer" },
              "recall": { "type": "integer" },
              "stewardship": { "type": "integer" }
            },
            "required": ["write", "recall", "stewardship"]
          },
          "total": { "type": "integer" }
        }
      },
      "RecommendationCard": {
        "type": "object",
        "required": ["cardId", "title", "advisory", "sourceReference", "evidenceRefs", "reason"],
        "properties": {
          "cardId": { "type": "string" },
          "title": { "type": "string" },
          "advisory": { "type": "boolean", "enum": [true] },
          "memoryId": { "type": "string" },
          "sourceReference": { "type": "string" },
          "confidence": { "type": "number" },
          "computedScore": { "type": "number", "description": "PI-P6-D1.1 sandbox score when re-rank applied" },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        }
      },
      "RecommendationRerankMetadata": {
        "type": "object",
        "required": ["applied"],
        "properties": {
          "applied": { "type": "boolean" },
          "decisionModelId": { "type": "string" },
          "decisionModelVersion": { "type": "string" },
          "sandboxOutcome": {
            "type": "string",
            "enum": ["ok", "timeout", "error", "denied", "disabled"]
          },
          "pluginDigestPrefix": { "type": "string" },
          "reason": { "type": "string" }
        }
      },
      "FetchRecommendationsRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string" },
          "limit": { "type": "integer", "maximum": 10 },
          "decisionModelId": { "type": "string", "description": "Optional PI-P6-D1.1 computed model for re-rank" },
          "decisionModelVersion": { "type": "string" }
        }
      },
      "FetchRecommendationsResponse": {
        "type": "object",
        "required": ["traceId", "cards", "advisory"],
        "properties": {
          "traceId": { "type": "string" },
          "cards": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RecommendationCard" }
          },
          "advisory": { "type": "boolean", "enum": [true] },
          "rerank": { "$ref": "#/components/schemas/RecommendationRerankMetadata" }
        }
      },
      "CreateDecisionProvenanceRequest": {
        "type": "object",
        "required": ["briefId", "verdict"],
        "properties": {
          "briefId": { "type": "string" },
          "packageId": { "type": "string" },
          "verdict": { "type": "string", "enum": ["accepted", "rejected"] },
          "rationale": { "type": "string", "maxLength": 4000 },
          "sourceMemoryIds": { "type": "array", "items": { "type": "string" } },
          "decisionModelId": { "type": "string" },
          "decisionModelVersion": { "type": "string" },
          "decisionModelPluginDigest": { "type": "string" },
          "sandboxOutcome": {
            "type": "string",
            "enum": ["ok", "timeout", "error", "denied", "disabled"]
          }
        }
      },
      "DecisionModelComputedPluginSummary": {
        "type": "object",
        "required": ["kind", "artifactDigestPrefix"],
        "properties": {
          "kind": { "type": "string", "enum": ["worker"] },
          "artifactDigestPrefix": { "type": "string" }
        }
      },
      "DecisionModelCatalogEntry": {
        "type": "object",
        "required": [
          "id",
          "version",
          "displayName",
          "stability",
          "executionProfileName",
          "capabilities"
        ],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "displayName": { "type": "string" },
          "description": { "type": "string" },
          "stability": { "type": "string", "enum": ["experimental", "stable", "deprecated"] },
          "executionProfileName": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "computedPlugin": { "$ref": "#/components/schemas/DecisionModelComputedPluginSummary" }
        }
      },
      "DecisionModelCatalogResponse": {
        "type": "object",
        "required": ["models"],
        "properties": {
          "models": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DecisionModelCatalogEntry" }
          }
        }
      },
      "DecisionProvenanceRecord": {
        "type": "object",
        "required": ["recordId", "ownerId", "briefId", "verdict", "sourceMemoryIds", "recordedAt"],
        "properties": {
          "recordId": { "type": "string" },
          "ownerId": { "type": "string" },
          "briefId": { "type": "string" },
          "packageId": { "type": "string" },
          "verdict": { "type": "string", "enum": ["accepted", "rejected"] },
          "rationale": { "type": "string" },
          "sourceMemoryIds": { "type": "array", "items": { "type": "string" } },
          "decisionModelId": { "type": "string" },
          "decisionModelVersion": { "type": "string" },
          "decisionModelPluginDigest": { "type": "string" },
          "sandboxOutcome": {
            "type": "string",
            "enum": ["ok", "timeout", "error", "denied", "disabled"]
          },
          "recordedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["Health"],
        "security": [],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "tags": ["Capabilities"],
        "security": [],
        "responses": { "200": { "description": "Capability manifest" } }
      }
    },
    "/capabilities/negotiate": {
      "post": {
        "operationId": "negotiateCapabilities",
        "tags": ["Capabilities"],
        "security": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ClientCapabilityRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Negotiation result matrix",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CapabilityNegotiationResult" }
              }
            }
          }
        }
      }
    },
    "/ecosystem/clients": {
      "get": {
        "operationId": "listEcosystemClients",
        "tags": ["Ecosystem"],
        "security": [],
        "responses": { "200": { "description": "Client catalog" } }
      }
    },
    "/ecosystem/clients/{type}": {
      "get": {
        "operationId": "getEcosystemClient",
        "tags": ["Ecosystem"],
        "security": [],
        "parameters": [
          { "name": "type", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Client profile" } }
      }
    },
    "/memory": {
      "get": {
        "operationId": "listMemories",
        "tags": ["Memory"],
        "parameters": [
          { "name": "project", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Memory list" } }
      },
      "post": {
        "operationId": "createMemory",
        "tags": ["Memory"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateMemoryRequest" } }
          }
        },
        "responses": { "201": { "description": "Created memory" } }
      }
    },
    "/memory/{id}": {
      "get": {
        "operationId": "getMemory",
        "tags": ["Memory"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": { "200": { "description": "Memory" } }
      },
      "put": {
        "operationId": "updateMemory",
        "tags": ["Memory"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateMemoryRequest" } }
          }
        },
        "responses": { "200": { "description": "Updated memory" } }
      },
      "delete": {
        "operationId": "deleteMemory",
        "tags": ["Memory"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/search": {
      "get": {
        "operationId": "searchMemories",
        "tags": ["Search"],
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Search results" } }
      }
    },
    "/context": {
      "post": {
        "operationId": "buildContext",
        "tags": ["Context"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/BuildContextRequest" } }
          }
        },
        "responses": { "200": { "description": "Context bundle" } }
      }
    },
    "/context/packages/{packageId}": {
      "get": {
        "operationId": "getContextPackageLifecycle",
        "tags": ["Context"],
        "summary": "Get Context Package lifecycle state (ADR-1013)",
        "parameters": [
          { "name": "packageId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Lifecycle record",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ContextPackageLifecycle" } }
            }
          }
        }
      }
    },
    "/context/packages/{packageId}/retire": {
      "post": {
        "operationId": "retireContextPackage",
        "tags": ["Context"],
        "summary": "Retire Context Package (active → retired)",
        "parameters": [
          { "name": "packageId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Updated lifecycle record",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ContextPackageLifecycle" } }
            }
          }
        }
      }
    },
    "/context/packages/{packageId}/archive": {
      "post": {
        "operationId": "archiveContextPackage",
        "tags": ["Context"],
        "summary": "Archive Context Package (active|retired → archived)",
        "parameters": [
          { "name": "packageId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Updated lifecycle record",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ContextPackageLifecycle" } }
            }
          }
        }
      }
    },
    "/governance/manifest": {
      "get": {
        "operationId": "getGovernanceManifest",
        "tags": ["Governance"],
        "summary": "Memory governance manifest (ADR-1020 / ADR-1021)",
        "responses": { "200": { "description": "Governance manifest registry" } }
      }
    },
    "/governance/stewardship/runs": {
      "get": {
        "operationId": "listStewardshipRuns",
        "tags": ["Governance"],
        "summary": "List stewardship run history for authenticated owner",
        "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Stewardship runs" } }
      }
    },
    "/governance/stewardship/runs/{runId}": {
      "get": {
        "operationId": "getStewardshipRun",
        "tags": ["Governance"],
        "summary": "Stewardship run detail",
        "parameters": [
          { "name": "runId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Stewardship run" } }
      }
    },
    "/governance/exceptions": {
      "get": {
        "operationId": "listGovernanceExceptions",
        "tags": ["Governance"],
        "summary": "List governance exception requests (PI-1027-B / ADR-1029)",
        "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Exception list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "exceptions": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/GovernanceExceptionRecord" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createGovernanceExceptionRequest",
        "tags": ["Governance"],
        "summary": "Create exception request (pending — no auto-approve)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateGovernanceExceptionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created exception request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "exception": { "$ref": "#/components/schemas/GovernanceExceptionRecord" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/governance/exceptions/{exceptionId}": {
      "get": {
        "operationId": "getGovernanceException",
        "tags": ["Governance"],
        "summary": "Governance exception request detail",
        "parameters": [
          { "name": "exceptionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Exception detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "exception": { "$ref": "#/components/schemas/GovernanceExceptionRecord" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/governance/denials": {
      "get": {
        "operationId": "listPolicyDenials",
        "tags": ["Governance"],
        "summary": "List policy denial events (PI-1027-C / ADR-1028 D4)",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "since", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": {
            "description": "Denial events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "denials": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/PolicyDenialEvent" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/governance/denials/summary": {
      "get": {
        "operationId": "getPolicyDenialSummary",
        "tags": ["Governance"],
        "summary": "Aggregated denial counts by evaluation point",
        "parameters": [
          { "name": "since", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": {
